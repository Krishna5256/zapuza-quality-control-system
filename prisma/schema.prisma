
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum InspectionStatus {
  PENDING
  PASS
  FAIL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model Product {
  id          Int          @id @default(autoincrement())
  serialNumber String      @unique
  name        String
  createdAt   DateTime     @default(now())
  inspections Inspection[]
  operations  ProductionOperation[]
  dispatches   Dispatch[]
}

model Inspection {
  id          Int              @id @default(autoincrement())
  productId   Int
  parameter   String
  measuredValue Float
  minValue    Float
  maxValue    Float
  status      InspectionStatus @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  product     Product          @relation(fields: [productId], references: [id])
  approval    InspectionApproval?
}

model InspectionApproval {
  id           Int            @id @default(autoincrement())
  inspectionId Int            @unique
  status       ApprovalStatus @default(PENDING)
  reviewer     String?
  reason       String?
  reviewedAt   DateTime?
  inspection   Inspection     @relation(fields: [inspectionId], references: [id])
}

model ProductionOperation {
  id             Int             @id @default(autoincrement())
  productId      Int
  sequence       Int
  name           String
  status         OperationStatus @default(PENDING)
  holdMinutes    Int             @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  holdUntil      DateTime?
  product        Product         @relation(fields: [productId], references: [id])

  @@unique([productId, sequence])
}

model Dispatch {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique
  dispatchedAt DateTime @default(now())
  dispatchedBy String
  product      Product  @relation(fields: [productId], references: [id])
}
